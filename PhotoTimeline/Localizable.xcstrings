          }
        }
      }
    },
    "Vorschau schließen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close preview"
          }
        }
      }
    },
    "Welche Teile des Datums beim Verschieben geändert werden": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which parts of the date change when dragging"
          }
        }
      }
    },
    "Zoom": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoom"
          }
        }
      }
    },
    "Änderungen verwerfen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discard Changes"
          }
        }
      }
